# Required before sending paid traffic.
# Use sk_test_... or sk_live_...
STRIPE_SECRET_KEY=
# Use Stripe price_... IDs for each sellable plan.
STRIPE_PRICE_SINGLE=
STRIPE_PRICE_BUNDLE3=
STRIPE_PRICE_UNLIMITED=
# Use whsec_...
STRIPE_WEBHOOK_SECRET=
# Use https:// for deployment; localhost/127.0.0.1 is allowed for local testing.
APP_BASE_URL=

# Optional local/staging purchase persistence.
# Leave blank for warm-runtime memory only.
PURCHASE_STATE_FILE=

# Optional live vehicle-data providers.
MARKETCHECK_API_KEY=
AUTODEV_API_KEY=
VEHICLE_HISTORY_API_URL=
VEHICLE_HISTORY_API_KEY=
AUCTION_EVIDENCE_API_URL=
AUCTION_EVIDENCE_API_KEY=
WEB_IMAGE_SEARCH_API_URL=
WEB_IMAGE_SEARCH_API_KEY=
